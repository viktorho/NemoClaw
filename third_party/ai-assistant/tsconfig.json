{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "noEmitOnError": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "lib": ["ES2023", "DOM"],
    "types": ["node"]
  },
  "include": ["backend/src/**/*.ts", "frontend/src/**/*.ts", "shared/src/**/*.ts", "test/**/*.ts"]
}
